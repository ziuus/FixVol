<?xml version="1.0" encoding="utf-8"?>
<!-- Network Security Config for FixVol -->
<!-- FixVol operates fully offline and declares no internet permission.
     This config is kept as a safety net: any code path that might
     accidentally attempt cleartext traffic will be blocked. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
